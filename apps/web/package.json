{
  "name": "@workoffdesk/web",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "The phone web app the workoffdesk server serves.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.sw.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && vitest run"
  },
  "dependencies": {
    "@workoffdesk/client": "workspace:*",
    "@workoffdesk/i18n": "workspace:*",
    "@workoffdesk/react": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}

{
  "name": "@workoffdesk/web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "The phone web app the workoffdesk server serves.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.sw.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && vitest run"
  },
  "dependencies": {
    "@workoffdesk/client": "workspace:*",
    "@workoffdesk/i18n": "workspace:*",
    "@workoffdesk/react": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "dompurify": "^3.4.16",
    "marked": "^16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}

{
  "name": "@workoffdesk/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm -r check && pnpm check:docs",
    "check:docs": "node --test scripts/*.test.mjs && node scripts/check-docs.mjs && node scripts/check-tests.mjs"
  }
}

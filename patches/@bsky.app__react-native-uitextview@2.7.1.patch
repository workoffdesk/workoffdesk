new file mode 100644
index 0000000000000000000000000000000000000000..2db70bcda259ca8a33c61810598f157e4f321f9d
--- /dev/null
+++ b/ios/RNUITextViewParagraphs.mm
@@ -0,0 +1,105 @@
+#import "RNUITextViewParagraphs.h"
+
+#import <UIKit/UIKit.h>
+#import <react/renderer/textlayoutmanager/RCTAttributedTextUtils.h>
+#include <react/utils/ManagedObjectWrapper.h>
+
+using namespace facebook::react;
+
+static void layOutParagraph(
+    NSMutableAttributedString *text,
+    NSRange paragraph,
+    const RNUITextViewParagraph &layout)
+{
+  [text enumerateAttribute:NSParagraphStyleAttributeName
+                   inRange:paragraph
+                   options:0
+                usingBlock:^(NSParagraphStyle *style, NSRange range, __unused BOOL *stop) {
+                  NSMutableParagraphStyle *laidOut = style ? [style mutableCopy] : [NSMutableParagraphStyle new];
+                  laidOut.firstLineHeadIndent = layout.firstLineHeadIndent;
+                  laidOut.headIndent = layout.headIndent;
+                  laidOut.paragraphSpacing = layout.paragraphSpacing;
+                  if (layout.headIndent > layout.firstLineHeadIndent) {
+                    laidOut.tabStops = @[ [[NSTextTab alloc] initWithTextAlignment:NSTextAlignmentNatural
+                                                                          location:layout.headIndent
+                                                                           options:@{}] ];
+                  }
+                  [text addAttribute:NSParagraphStyleAttributeName value:laidOut range:range];
+                }];
+}
+
+// As RCTApplyBaselineOffset, per paragraph, so a heading's taller lines do not
+// move the lines of the paragraphs around it.
+static void centerLines(NSMutableAttributedString *text, NSRange paragraph)
+{
+  __block CGFloat lineHeight = 0;
+  [text enumerateAttribute:NSParagraphStyleAttributeName
+                   inRange:paragraph
+                   options:NSAttributedStringEnumerationLongestEffectiveRangeNotRequired
+                usingBlock:^(NSParagraphStyle *style, __unused NSRange range, __unused BOOL *stop) {
+                  lineHeight = MAX(lineHeight, style.maximumLineHeight);
+                }];
+  if (lineHeight == 0) {
+    return;
+  }
+  __block CGFloat fontHeight = 0;
+  [text enumerateAttribute:NSFontAttributeName
+                   inRange:paragraph
+                   options:NSAttributedStringEnumerationLongestEffectiveRangeNotRequired
+                usingBlock:^(UIFont *font, __unused NSRange range, __unused BOOL *stop) {
+                  fontHeight = MAX(fontHeight, font.lineHeight);
+                }];
+  if (lineHeight < fontHeight) {
+    return;
+  }
+  [text addAttribute:NSBaselineOffsetAttributeName value:@((lineHeight - fontHeight) / 2) range:paragraph];
+}
+
+NSAttributedString *RNUITextViewNSAttributedString(
+    const AttributedString &attributedString,
+    const std::vector<RNUITextViewParagraph> &paragraphs)
+{
+  NSMutableAttributedString *text = [RCTNSAttributedStringFromAttributedString(attributedString) mutableCopy];
+
+  if (!paragraphs.empty()) {
+    // The conversion holds each fragment's text in turn, an attachment as one character.
+    const auto &fragments = attributedString.getFragments();
+    std::vector<NSUInteger> starts;
+    starts.reserve(fragments.size());
+    NSUInteger at = 0;
+    for (const auto &fragment : fragments) {
+      starts.push_back(at);
+      at += [NSString stringWithUTF8String:fragment.string.c_str()].length;
+    }
+    if (at == text.length) {
+      for (const auto &paragraph : paragraphs) {
+        const NSRange start = NSMakeRange(starts[paragraph.fragmentIndex], 0);
+        layOutParagraph(text, [text.string paragraphRangeForRange:start], paragraph);
+      }
+    }
+  }
+
+  [text.string enumerateSubstringsInRange:NSMakeRange(0, text.length)
+                                  options:NSStringEnumerationByParagraphs | NSStringEnumerationSubstringNotRequired
+                               usingBlock:^(__unused NSString *substring,
+                                            __unused NSRange substringRange,
+                                            NSRange enclosingRange,
+                                            __unused BOOL *stop) {
+                                 centerLines(text, enclosingRange);
+                               }];
+  return text;
+}
+
+namespace facebook::react {
+
+AttributedStringBox RNUITextViewMeasurableString(
+    const AttributedString &attributedString,
+    const std::vector<RNUITextViewParagraph> &paragraphs)
+{
+  if (paragraphs.empty()) {
+    return AttributedStringBox{attributedString};
+  }
+  return AttributedStringBox{wrapManagedObject(RNUITextViewNSAttributedString(attributedString, paragraphs))};
+}
+
+} // namespace facebook::react

+// TextKit 1 fills a background that wraps to the next line out to the edges of
+// both lines, over a paragraph's indent too. Fill only under the glyphs.
+@interface RNUITextViewLayoutManager : NSLayoutManager
+@end
+
+@implementation RNUITextViewLayoutManager
+
+- (void)fillBackgroundRectArray:(const CGRect *)rectArray
+                          count:(NSUInteger)rectCount
+              forCharacterRange:(NSRange)charRange
+                          color:(UIColor *)color
+{
+  __block std::vector<CGRect> rects(rectArray, rectArray + rectCount);
+  const NSRange glyphs = [self glyphRangeForCharacterRange:charRange actualCharacterRange:NULL];
+  [self enumerateLineFragmentsForGlyphRange:glyphs
+                                 usingBlock:^(CGRect line,
+                                              __unused CGRect used,
+                                              NSTextContainer *container,
+                                              NSRange lineGlyphs,
+                                              __unused BOOL *stop) {
+                                   const CGRect inked =
+                                       [self boundingRectForGlyphRange:NSIntersectionRange(lineGlyphs, glyphs)
+                                                       inTextContainer:container];
+                                   for (auto &rect : rects) {
+                                     const CGFloat middle = CGRectGetMidY(rect);
+                                     if (middle < CGRectGetMinY(line) || middle >= CGRectGetMaxY(line)) {
+                                       continue;
+                                     }
+                                     const CGFloat left = MAX(CGRectGetMinX(rect), CGRectGetMinX(inked));
+                                     const CGFloat right = MIN(CGRectGetMaxX(rect), CGRectGetMaxX(inked));
+                                     if (right > left) {
+                                       rect.origin.x = left;
+                                       rect.size.width = right - left;
+                                     }
+                                   }
+                                 }];
+  [super fillBackgroundRectArray:rects.data() count:rects.size() forCharacterRange:charRange color:color];
+}
+
+@end
+
